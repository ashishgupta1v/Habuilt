APP_NAME=Habuilt
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

HABUILT_DEMO_USER_ID=01JQ7M2X4V8K3P6R9T1W5Y7ZAB

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Get these from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required. Must match the Supabase project JWT secret (Project Settings > API > JWT Secret).
# API requests are rejected when this is empty. Do not put a real secret in this example.
SUPABASE_JWT_SECRET=

# Server-only. Project URL from Supabase Dashboard > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY deletes the Auth user during account erasure.
# Leave both empty here. Never prefix the service-role key with VITE_.
SUPABASE_URL=
# Public anon key used to exchange the httpOnly refresh cookie.
# Same value as VITE_SUPABASE_ANON_KEY. Not a service-role key.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only ZoetiCoach Habit Cloud credential.
# Both must be set or the server skips the remote call.
# Leave empty until a new token is created in the ZoetiCoach admin.
# Do not put a token in any VITE_ variable. Revoke any token that was previously in the client.
ZOETICOACH_API_URL=
ZOETICOACH_API_KEY=

DB_CONNECTION=pgsql
# Supabase connection string (recommended):
# DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# Used only by `php artisan habuilt:secure-ledger`.
# Leave empty until the Supabase Postgres URL is available.
# This does not replace the app database.
HABUILT_LEDGER_DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sentry. Server relay only. Leave VITE_SENTRY_DSN empty so the browser bundle
# does not contain the DSN secret. The browser posts to /api/telemetry/tunnel.
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
