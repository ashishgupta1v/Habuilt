[Unit]
Description=Habuilt Laravel Queue Worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=5s
WorkingDirectory=/var/www/Habuilt
ExecStart=/usr/bin/php /var/www/Habuilt/artisan queue:work --sleep=3 --tries=3 --max-time=3600
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
